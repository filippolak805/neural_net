{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build network",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O3",
                "-fopenmp",
                "-std=c++20",
                "-I", "src",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/network"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the neural network binary"
        }
    ],
    "version": "2.0.0"
}
